# ── Secrets ───────────────────────────────────────────────
# Git compare le NOM DE FICHIER COMPLET : le motif `.env` seul ne couvre
# ni `secrets.env`, ni `prod.env`, ni `.env.local`. D'où les motifs larges.
.env
.env.*
*.env
*.key
*.pem
*.p12
*.pfx
credentials*
secrets*

# Exceptions : les gabarits ne contiennent aucune valeur réelle.
# (Une négation doit être placée APRÈS le motif qu'elle annule.)
!.env.example
!*.env.example

# ── Python ────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/

# ── Input images (données personnelles) ───────────────────
input/*
!input/.gitkeep

# ── Output : garder les CSV de référence, ignorer le reste ─
output/*
!output/transactions.example.csv

# ── IDE / OS ──────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ── Serena (agent local) ──────────────────────────────────
.serena/

# Generated test reports
tests/reports/

# AI tooling (machine-scoped)
.claude/
